# Leave unset for local dev -- requests to /api/* go through the Vite dev server proxy
# (vite.config.ts) to the Worker at :8787, which keeps them same-origin so the session/CSRF
# cookies (SameSite=Lax) are sent. Only set this to point at a different, same-site Worker
# (e.g. a deployed one once a production custom domain exists).
# VITE_API_URL=http://localhost:8787

# Enables the mock billing flow's UI (src/features/billing/flags.ts) -- must be the literal string
# "true" to enable it. Unset defaults to off in a browser build (on in non-production Node/test
# runs). Independent of the Worker's own BILLING_MOCK_ENABLED (services/api/.dev.vars.example) --
# both gate the same demo flow from their own side and should usually be set together.
# VITE_BILLING_MOCK_ENABLED=true

# Optional JSON object of affiliate tracking params appended to provider links (parsed by
# src/features/history/useAffiliateParams.ts). Unset or invalid JSON both mean no params are added.
# VITE_AFFILIATE_PARAMS={"utm_source":"pairflix"}
