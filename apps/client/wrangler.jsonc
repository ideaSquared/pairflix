{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pairflix-client",
	"compatibility_date": "2026-08-01",
	"assets": {
		"directory": "dist",
		"not_found_handling": "single-page-application"
	},
	// Staging, deployed by shipper (`wranglerEnv` in ship.yaml); production keeps the top-level name.
	"env": {
		"staging": {
			"name": "pairflix-client-staging"
		},
		"production": {
			"name": "pairflix-client"
		}
	}
}
