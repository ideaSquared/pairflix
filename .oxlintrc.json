{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "settings": {
    "react": {
      "version": "19.0"
    }
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "no-debugger": "error",
    "prefer-const": "error",
    "no-var": "error",
    "eqeqeq": ["error", "always"],
    "no-duplicate-imports": "error",
    "no-eval": "error",
    "no-new-func": "error",
    "no-useless-assignment": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "react/no-danger": "error",
    "react/forbid-component-props": [
      "error",
      {
        "forbid": [
          {
            "propName": "style",
            "message": "Use a vanilla-extract class instead of an inline style."
          }
        ]
      }
    ],
    "react/set-state-in-effect": "off",
    "react/immutability": "off",
    "react/purity": "off",
    "react/refs": "off",
    "react/no-did-mount-set-state": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "typescript/no-useless-empty-export": "off",
    "jsx-a11y/no-noninteractive-element-interactions": [
      "error",
      {
        "handlers": [
          "onClick",
          "onError",
          "onLoad",
          "onMouseDown",
          "onMouseUp",
          "onKeyPress",
          "onKeyDown",
          "onKeyUp"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.{test,spec}.{ts,tsx}",
        "**/__tests__/**",
        "**/*.config.{ts,js,mjs}"
      ],
      "rules": {
        "typescript/no-explicit-any": "off",
        "no-console": "off"
      }
    },
    {
      "files": ["services/api/src/**/*.ts"],
      "excludeFiles": ["**/*.{test,spec}.ts", "**/__tests__/**"],
      "rules": {
        "no-console": "error"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    ".turbo",
    "**/*.d.ts"
  ]
}
