{
  "name": "@pairflix/components",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:a11y": "vitest run --testNamePattern=\"accessibility|a11y|axe\"",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md,mdx}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^4.0.0 || ^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "clsx": "^2.1.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@pairflix/eslint-config-react": "workspace:*",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-onboarding": "^10.6.8",
    "@storybook/react": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@tanstack/react-query": "^5.108.4",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/recipes": "^0.5.5",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^31.0.1",
    "react-router-dom": "^7.18.6",
    "rollup": "^4.68.8",
    "storybook": "^10.6.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
