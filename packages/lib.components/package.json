{
  "name": "@pairflix/components",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "test": "jest",
    "test:a11y": "jest --testNamePattern=\"accessibility|a11y|axe\" --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md,mdx}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^4.0.0 || ^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.13.0",
    "@jest/types": "^30.4.1",
    "@pairflix/eslint-config-react": "workspace:*",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-onboarding": "^10.5.8",
    "@storybook/react": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vanilla-extract/css": "^1.17.0",
    "@vanilla-extract/jest-transform": "^1.1.22",
    "@vanilla-extract/recipes": "^0.5.5",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.17.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "react-router-dom": "^7.18.2",
    "rollup": "^4.62.4",
    "storybook": "^10.5.8",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "vite": "^8.2.1"
  }
}
