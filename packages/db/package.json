{
  "name": "@pairflix/db",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@pairflix/eslint-config-base": "workspace:*",
    "@vitest/coverage-v8": "^4.1.0",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.17.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
