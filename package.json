{
  "name": "pairflix-workspace",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.22.0 <23.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "husky || true",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch --parallel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "type-check": "turbo run type-check",
    "format": "prettier --cache --write \"**/*.{ts,tsx,js,mjs,jsx,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --cache --check \"**/*.{ts,tsx,js,mjs,jsx,json,md}\" --ignore-path .prettierignore",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@pairflix/eslint-config-base": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.9.16",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "esbuild": "^0.25.0"
    }
  }
}
