{
  "name": "pairflix-workspace",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "husky || true",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch --parallel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "type-check": "turbo run type-check",
    "format": "prettier --cache --write \"**/*.{ts,tsx,js,mjs,jsx,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --cache --check \"**/*.{ts,tsx,js,mjs,jsx,json,md}\" --ignore-path .prettierignore",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2"
  }
}
